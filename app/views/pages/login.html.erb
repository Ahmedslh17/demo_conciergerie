<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background-color: #f8fafc; font-family: system-ui, -apple-system, sans-serif;">
  <div style="background: white; padding: 40px; border-radius: 16px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05); width: 100%; max-width: 400px; border: 1px solid #e2e8f0;">
    
    <div style="text-align: center; margin-bottom: 24px;">
      <h2 style="color: #0f172a; font-size: 24px; font-weight: 700; margin-bottom: 8px;">Administration</h2>
      <p style="color: #64748b; font-size: 14px;">Connectez-vous pour accéder au tableau de bord</p>
    </div>
    
    <% if flash[:alert] %>
      <div style="background-color: #ffeeec; color: #991b1b; padding: 12px; border-radius: 8px; font-size: 14px; margin-bottom: 20px; border: 1px solid #fecaca;">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with(url: login_path, method: :post, data: { turbo: false }) do |f| %>
      <div style="margin-bottom: 16px;">
        <%= f.label :username, "Nom d'utilisateur", style: "display: block; font-size: 14px; font-weight: 600; color: #334155; margin-bottom: 6px;" %>
        <%= f.text_field :username, placeholder: "admin", style: "width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; box-sizing: border-box; outline: none;" %>
      </div>

      <div style="margin-bottom: 24px;">
        <%= f.label :password, "Mot de passe", style: "display: block; font-size: 14px; font-weight: 600; color: #334155; margin-bottom: 6px;" %>
        <%= f.password_field :password, placeholder: "••••••••", style: "width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; box-sizing: border-box; outline: none;" %>
      </div>

      <%= f.submit "Se connecter", style: "width: 100%; padding: 12px; background: #4f46e5; color: white; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer;" %>
    <% end %>
    
    <div style="text-align: center; margin-top: 20px;">
      <a href="/" style="color: #64748b; font-size: 13px; text-decoration: none;">← Retourner à l'accueil</a>
    </div>

  </div>
</div>